{
  "manifest_version": 3,
  "name": "GryphCal",
  "version": "0.1.0",
  "description": "All your CourseLink assignments and quizzes on one calendar. Built by a Gryphon, for Gryphons.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://courselink.uoguelph.ca/*"
  ],
  "action": {
    "default_title": "GryphCal",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://courselink.uoguelph.ca/d2l/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
